    function changeDivision( costCenter , division ){

        if( division === "ทั้งหมด" ){
            let thisCostCenter = mainData.filter( function(e){
                return  e.CostCenter == costCenter
            } )

            const data = [{
                divisionInCostCenter : thisCostCenter[0].divisionInCostCenter , 
                StastDate : thisCostCenter[0].StastDate , 
                EndDate: thisCostCenter[0].EndDate ,
                CostCenter: thisCostCenter[0].CostCenter,
                ExpresswayTotalPrice: thisCostCenter[0].ExpresswayTotalPrice,
                RefuelingTotalPrice: thisCostCenter[0].RefuelingTotalPrice ,
                CarRentTotalPrice: thisCostCenter[0].CarRentTotalPrice,
                Expressway: thisCostCenter[0].Expressway,
                Refueling: thisCostCenter[0].Refueling ,
                CarRent: thisCostCenter[0].CarRent
            }]
            
            generateDataSubCard(data)
            return
        }

        let thisCostCenter = mainData.filter( function(e){
            return  e.CostCenter == costCenter
        } )
        let thisCostCenter_Refueling = thisCostCenter[0].Refueling
        let thisCostCenterAndThisDivision_RefuelingDoc = thisCostCenter_Refueling.filter( function(e){
            return  e.user_division == division
        } )
        let thisCostCenterAndThisDivision_RefuelingPrice = 0
        thisCostCenterAndThisDivision_RefuelingDoc.map( item => {
            thisCostCenterAndThisDivision_RefuelingPrice += (+item.rrm_total_change_cost)
        } )

        let thisCostCenter_Expressway = thisCostCenter[0].Expressway
        let thisCostCenterAndThisDivision_ExpresswayDoc = thisCostCenter_Expressway.filter( function(e){
            return  e.user_division == division
        } )
        let thisCostCenterAndThisDivision_ExpresswayPrice = 0
        thisCostCenterAndThisDivision_ExpresswayDoc.map( item => {
            thisCostCenterAndThisDivision_ExpresswayPrice += (+item.rer_price)
        } )

        let thisCostCenter_CarRent = thisCostCenter[0].CarRent
        let thisCostCenterAndThisDivision_CarRentDoc = thisCostCenter_CarRent.filter( function(e){
            return  e.user_division == division
        } )
        let thisCostCenterAndThisDivision_CarRentPrice = 0
        thisCostCenterAndThisDivision_CarRentDoc.map( item => {
            thisCostCenterAndThisDivision_CarRentPrice += (+item.cds_car_price_rate)
        } )

        const data = [{
            divisionInCostCenter : thisCostCenter[0].divisionInCostCenter , 
            StastDate : thisCostCenter[0].StastDate , 
            EndDate: thisCostCenter[0].EndDate ,
            CostCenter: thisCostCenter[0].CostCenter,
            ExpresswayTotalPrice: thisCostCenterAndThisDivision_ExpresswayPrice,
            RefuelingTotalPrice: thisCostCenterAndThisDivision_RefuelingPrice ,
            CarRentTotalPrice: thisCostCenterAndThisDivision_CarRentPrice,
            Expressway: thisCostCenterAndThisDivision_ExpresswayDoc,
            Refueling: thisCostCenterAndThisDivision_RefuelingDoc ,
            CarRent: thisCostCenterAndThisDivision_CarRentDoc
        }]
        
        generateDataSubCard(data)
        
    }

    function SubmitFilter(){
        const StastTimestamp = document.getElementById("filter_time_start").value === "" ? "-" : new Date(document.getElementById("filter_time_start").value).getTime()
        const EndTimestamp = document.getElementById("filter_time_end").value === "" ? "-" : new Date(document.getElementById("filter_time_end").value).getTime()

        window.location.replace( "/reportCostCenter/" + StastTimestamp + "/" + EndTimestamp )
    }

