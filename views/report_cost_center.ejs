<script>

    function DownloadExcel_Refueling_All( startDate , endDate ){
        console.log(new Date(startDate))
        console.log(new Date(endDate))

        let allselect = Array.from(document.getElementsByName("CostCenterSelected_1"))
        let allselected = allselect.filter( function(e){
            return  e.checked == true
        } )
        let allselectedTest = Array.from(allselected).map(item => item.value).join(',')
        
        axios.post('/DownloadExcel_Refueling_All', {
            startDate : new Date(startDate) , 
            endDate : new Date(endDate) , 
            CostCenterListText : allselectedTest
        })
        .then(function (response) {
            console.log("response");
            console.log(response);
            if( response.data.message === "error" ){
                alert(response.data.description)
            }else{
                DownloadExcel_All(response.data.result , "ค่าน้ำมัน")
            }
        })
        .catch(function (error) {
            console.log(error);
        })
        .finally(function () {
            // always executed
        });

    }

