    function getData_Expressway( data ){
        return new Promise( (resolve , reject) => {
            let dataOut = []
            const _mainData = mainData[0]
            if( data.length > 0 ){
                for( let i = 0 ; i < data.length ; i++ ){
                    let division = (data[i].user_division).split("-")
                    let site = ""
                    let index = i + 1
                    if( division[0].startsWith("00") ){
