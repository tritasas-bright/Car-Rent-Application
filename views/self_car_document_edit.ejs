function set_employee_option( data ){
    let text = ""
    for( let i = 0 ; i < data.length ; i++ ){
        text += `<option value="${data[i].user_id}">${data[i].user_emp_id} - ${data[i].user_nane_th} ${data[i].user_surname_th} (${data[i].user_nane_en} ${data[i].user_surname_en})</option>`

        if( i === data.length - 1 ){
            document.getElementById("employee_select").innerHTML = text
            $('.selectpicker').selectpicker('refresh');
        }
    }
}

