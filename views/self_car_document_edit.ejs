<script>

window.onload = function(){
    data_no_syntex = '<%= JSON.stringify(user_data) %>'
    data_no_free_spec = (JSON.stringify(data_no_syntex.replace(/\n|\t|\r/g, " ")))
    data_with_syntax = decodedString( data_no_free_spec )
    data_to_obj = JSON.parse(data_with_syntax);

    console.log("user_data")
    console.log(data_to_obj.cr_user_app_id)

    $.ajax({
        type: 'GET',
        url: '/EmployeeList',
        data: {},
        success: function (values) {
            employee_select_data = values.EmployeeList
            SelectedEmployee_1( data_to_obj.cr_user_app_id )

        },
        error: function (error) {
            console.log("error with Ajax");
            console.log(error);
        }
    });
}

function uploadFile( type , input_id ){
    let filesArray = document.getElementById(input_id).files
    console.log(filesArray)

    if( filesArray.length > 5 ){
        return alert( "อัพได้มากสุดครั้งละ 5 รูปเท่านั้น" )
    }
    
    if( filesArray.length > 0 ){
        const formDataFileUpload = new FormData();
        for( let i = 0 ; i < filesArray.length ; i++ ){
            formDataFileUpload.append( "fileupload" , filesArray[i] );
            formDataFileUpload.append( "fileuploadName" , filesArray[i].name );

            if( i === filesArray.length - 1 ){
                formDataFileUpload.append( "DocumnetData" , JSON.stringify({
                    DocumnetId : document.getElementById("sdm_id").value , 
                    type : type
                }))

                $.ajax({
                    type: 'POST',
                    url: '/SelfCarDocument/UploadImg',
                    data: formDataFileUpload,
                    processData: false, // สำคัญ: ไม่แปลงข้อมูลเป็นสตริง
                    contentType: false, // สำคัญ: ตั้งค่าเป็น false เพื่อให้ส่งแบบ multipart/form-data
                    success: function (result) {
                        Swal.fire({
                            title: "สำเร็จ" ,
                            text: "" ,
                            icon: "success" , 
                        });

                        setTimeout( () => {
                            window.location.reload()
                        } , 800 )
                    },
                    error: function (error) {
                        Swal.fire({
                            title: "error" ,
                            text: error ,
                            icon: "error" , 
                        });
                    }
                });
            }
        }
    }
}

function updateRemark( subDocId , remark ){
    if( subDocId === "" ){
        return
    }

    const data = {
        LocationId : subDocId , 
        remark : remark
    }

    $.ajax({
        type: 'POST',
        url: '/Document/Loction/Update/Remark',
        data: data,
        success: function (values) {
            
        },
        error: function (error) {
            Swal.fire({
                title: "error with Ajax" ,
                text: error ,
                icon: "error" , 
            });
        }
    });
}

function fetchLocation_data(){
    $.ajax({
        type: 'GET',
        url: '/LocationList' ,
        data: {},
        success: function (values) {
            const LocationData = values.LocationList
            createTableLocation(LocationData)
        },
        error: function (error) {
            console.log("error with Ajax");
            console.log(error);
        }
    });
}

function createTableLocation(LocationData){
    let text = ""
    if( LocationData.length === 0 ){
        setTableLocation(text)
    }else{
        for( let i = 0 ; i < LocationData.length ; i++ ){
            text += `
            <tr>
                <td>
                    <button onclick="SelectLocation('${LocationData[i].lct_id}' , '${LocationData[i].lct_local_name}')" style="padding: .25rem .7rem;" type="button" class="btn btn-outline-success">
                        <i class="fa-solid fa-hand-pointer" style="margin-right: 0.1rem;" ></i>
                        เลือก
                    </button>
                </td>
                <td>${LocationData[i].lct_local_name}</td>
                <td>
                    <button onclick="setImageLocation('${LocationData[i].lct_img_path_show}' , '${LocationData[i].lct_local_name}')" data-bs-toggle="modal" data-bs-target="#modal_view_location_img" style="padding: .25rem .7rem;" type="button" class="btn btn-outline-primary">
                        <i class="fa-solid fa-image"></i>
                    </button>
                    <a href="${LocationData[i].lct_local_link}" target="_blank">
                        <button style="padding: .25rem .7rem;" type="button" class="btn btn-outline-primary">
                            <i class="fa-solid fa-map-location-dot"></i>
                        </button>
                    </a>
                </td>
            </tr>`

            if( i === LocationData.length - 1 ){
                setTableLocation(text)
            }
        }
    }
}

function setImageLocation( imgPath , locationName ){
    document.getElementById("locationImgDiv").innerHTML = `
    <img class="img-radius img-fluid wid-80" src="${imgPath}" style="padding:7px;margin-right:20px; width: auto; height: 70vh;"/>
    `
    document.getElementById("xxx").innerText = locationName

}

function setTableLocation(text){
    document.getElementById("locationDiv").innerHTML = 
    `<table id="LocationTable" class="table table-hover table-bordered" style="width: 100%;">
        <thead>
            <tr>
                <th width="10%">เลือก</th>
                <th>ชื่อสถานที่</th>
                <th width="10%">ข้อมูล</th>
            </tr>
        </thead>
        <tbody>
            ${text}
        </tbody>
    </table>`

    setTimeout_set_table( "LocationTable" , 200 )
}

function SelectLocation( LocationId , LocationName ){
    const document_id = document.getElementById("sdm_id").value

    if( LocationId !== "" && document_id !== "" ){
        Swal.fire({
            icon : "question",
            title: "เพิ่ม Location ใหม่",
            html: `
                เพิ่ม Location : ${LocationName} <br>
                ในเอกสารหรือไม่ ?
            `,
            showCancelButton: true,
            confirmButtonColor: "#027E6F",
            cancelButtonColor: "#00000040",
            confirmButtonText: "ยืนยัน, เพิ่ม" ,
            cancelButtonText: "ปิด"
        }).then((result) => {
            if (result.isConfirmed) {
                const data = {
                    DocumentId : document_id ,
                    LocationId : LocationId
                }
                $.ajax({
                    type: 'POST',
                    url: '/Document/Location/Insert',
                    data: data,
                    success: function (values) {
                        Swal.fire({
                            title: "สำเร็จ !",
                            text: "" ,
                            icon: "success"
                        });
                        setTimeout( () => {
                            window.location.reload();
                        } , 800 )
                    },
                    error: function (error) {
                        Swal.fire({
                            title: "error with Ajax" ,
                            text: error ,
                            icon: "error" , 
                        });
                    }
                });
            }
        });
    }
}

const draggables = document.querySelectorAll(".shallow-draggable")
const containers = document.querySelectorAll(".draggable-container")

draggables.forEach((draggable) => {
  // Start dragging
  draggable.addEventListener("dragstart", () => {
    draggable.classList.add("dragging")
  })

  // End dragging
  draggable.addEventListener("dragend", () => {
    draggable.classList.remove("dragging")

    // Show the current order of draggable elements after dropping
    const updatedDraggables = document.querySelectorAll(".shallow-draggable")
    console.log([...updatedDraggables].map(el => el.id || "0"))
    let data = [...updatedDraggables].map(el => el.id || "0")
    updatePriority(data)
  })
})

containers.forEach((container) => {
  container.addEventListener("dragover", function (e) {
    e.preventDefault()
    const afterElement = dragAfterElement(container, e.clientY)
    const dragging = document.querySelector(".dragging")
    if (afterElement == null) {
      container.appendChild(dragging)
    } else {
      container.insertBefore(dragging, afterElement)
    }
  })
})

function dragAfterElement(container, y) {
  const draggableElements = [...container.querySelectorAll(".shallow-draggable:not(.dragging)")]

  return draggableElements.reduce(
    (closest, child) => {
      const box = child.getBoundingClientRect()
      const offset = y - box.top - box.height / 2
      if (offset < 0 && offset > closest.offset) {
        return { offset: offset, element: child }
      } else {
        return closest
      }
    },
    { offset: Number.NEGATIVE_INFINITY }
  ).element
}

