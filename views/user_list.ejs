<%- include("2_footer.ejs") %>

<script>

    async function RefreshCostCenter(){
        Swal.fire({
            title: "Refresh Cost Center",
            html: `ยืนยันการ Refresh Cost Center หรือไม่`,
            icon: "question",

            showCancelButton: true,
            confirmButtonColor: "#13a787",
            confirmButtonText: "ยืนยัน",
            cancelButtonColor: "#6c757d",
            cancelButtonText: "ปิด",

        }).then(async (result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: 'GET',
                    url: '/RefreshCostCenter',
                    data: {},
                    success: function (result) {
                        Swal.fire({
                            title: "สำเร็จ",
                            text: "Refresh สำเร็จแล้ว",
                            icon: "success"
                        });
                        setTimeout( () => {
                            window.location.reload()
                        } , 800 )
                    },
                    error: function (error) {
                        Swal.fire({
                            title: "ไม่สำเร็จ",
                            text: "Refresh ไม่สำเร็จแล้ว",
                            icon: "error"
                        });
                    }
                });
            } 
        })
    }

    async function RefreshActivityNumber(){
        Swal.fire({
            title: "Refresh Activity Number",
            html: `ยืนยันการ Refresh Activity Number หรือไม่`,
            icon: "question",

            showCancelButton: true,
            confirmButtonColor: "#13a787",
            confirmButtonText: "ยืนยัน",
            cancelButtonColor: "#6c757d",
            cancelButtonText: "ปิด",

        }).then(async (result) => {
            if (result.isConfirmed) {
                document.getElementById("main_contain").innerHTML = `
                <div style="width: 5rem; height: 5rem;" class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>`

                $.ajax({
                    type: 'GET',
                    url: '/RefreshActivityNumber',
                    data: {},
                    success: function (result) {
                        Swal.fire({
                            title: "สำเร็จ",
                            text: "Refresh สำเร็จแล้ว",
                            icon: "success"
                        });
                        setTimeout( () => {
                            window.location.reload()
                        } , 800 )
                    },
                    error: function (error) {
                        Swal.fire({
                            title: "ไม่สำเร็จ",
                            text: "Refresh ไม่สำเร็จแล้ว",
                            icon: "error"
                        });
                    }
                });
            } 
        })
    }

