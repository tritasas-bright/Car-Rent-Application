<%- include("1_header.ejs") %>

<div class='dashboard-content'>
    <div class='container'>
        <div class='card'>
            <div class='card-header'>
                <h4>รายการเอกสารขอยืมรถยนต์ทั้งหมด</h4>
            </div>
            <div class='card-body'>
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12" style="margin-bottom: 2vh;">
                        <button onclick="include_work()" id="btn_include_work" disabled type="button" class="btn btn-primary">
                            <i class="fa-solid fa-sitemap" style="margin-right: 0.1vw;"></i>
                            เชื่อมงาน <span id="length_include_work">(0)</span>
                        </button>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12" style="margin-bottom: 7px;">
                        <table id="main_table" class="table table-hover table-bordered" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>#</th>
                                    <th>เครื่องมือ</th>
                                    <th>สถานะ</th>
                                    <th>วันที่ยืม</th>
                                    <th>Doc. NO.</th>
                                    <th>ผู้ยืมชื่อ-นามสกุล (แผนก)</th>
                                    <th>ผู้ขับ</th>
                                    <th>Eazy Pass</th>
                                    <th>บัตรเติมน้ำมัน</th>
                                    <th>ทะเบียนรถที่ยืม</th>
                                    <th>ชื่อรถที่ยืม</th>
                                    <th>ผู้สร้างชื่อ-นามสกุล (แผนก)</th>
                                    <th>สร้างเมื่อ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% index = 1 %>
                                <% document_alltime_data.forEach( function(e) { %>
                                    <tr>
                                        <td><%= index %></td>
                                        <td>
                                            <% if (e.cds_status == "อนุมัติแล้ว" && e.cdm_driver_type == "พนักงานขับรถ" ) { %>
                                                <div class="checkbox-wrapper-30">
                                                    <span class="checkbox">
                                                        <input name="check_box_list_1" id="<%= e.cds_id %>" onchange="update_check_box_list_1()" type="checkbox" />
                                                        <svg>
                                                            <use xlink:href="#checkbox-30" class="checkbox"></use>
                                                        </svg>
                                                    </span>
                                                    <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
                                                        <symbol id="checkbox-30" viewBox="0 0 22 22">
                                                            <path fill="none" stroke="currentColor" d="M5.5,11.3L9,14.8L20.2,3.3l0,0c-0.5-1-1.5-1.8-2.7-1.8h-13c-1.7,0-3,1.3-3,3v13c0,1.7,1.3,3,3,3h13 c1.7,0,3-1.3,3-3v-13c0-0.4-0.1-0.8-0.3-1.2"/>
                                                        </symbol>
                                                    </svg>
                                                </div>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/car_rent_document_approve_view/<%= btoa(e.cdm_id) %>">
                                                <button type="button" class="btn btn-primary btn-icon">
                                                    <i class="fa-solid fa-magnifying-glass"></i>
                                                </button>
                                            </a>
                                            <% if( e.cds_status == "สำเร็จแล้ว" ){ %>
                                                <a title="ประวัติการเติมน้ำมัน" href="/refueling_document/<%= btoa(e.cds_id) %>">
                                                    <button type="button" class="btn btn-primary btn-icon">
                                                        <i class="fa-solid fa-list-ol"></i>
                                                    </button>
                                                </a>
                                            <% } %>

                                            <% if( e.cds_include_work == "/" ){ %>
                                                <a onclick="view_include_work( '<%= e.cds_id %>')" >
                                                    <button type="button" class="btn btn-warning btn-icon">
                                                        <i class="fa-solid fa-sitemap"></i>
                                                    </button>
                                                </a>
                                            <% }else{ %>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if( e.cds_status == "อนุมัติแล้ว" ){ %>
                                                <div class="alert alert-warning" role="alert" style="padding: 0.3rem 1rem; margin-bottom: 0rem;">
                                                    รอส่งรถ
                                                </div>
                                            <% }else if( e.cds_status == "ส่งรถแล้ว" ){ %>
                                                <div class="alert alert-secondary" role="alert" style="padding: 0.3rem 1rem; margin-bottom: 0rem;">
                                                    รอผู้ขอ
                                                </div>
                                            <% }else if( e.cds_status == "รับรถแล้ว" ){ %>
                                                <div class="alert alert-info" role="alert" style="padding: 0.3rem 1rem; margin-bottom: 0rem;">
                                                    กำลังใช้งาน
                                                </div>
                                            <% }else if( e.cds_status == "คืนรถแล้ว" ){ %>
                                                <div class="alert alert-danger" role="alert" style="padding: 0.3rem 1rem; margin-bottom: 0rem;">
                                                    ตรวจรถ
                                                </div>
                                            <% }else if( e.cds_status == "สำเร็จแล้ว" ){ %>
                                                <div class="alert alert-success" role="alert" style="padding: 0.3rem 1rem; margin-bottom: 0rem;">
                                                    สำเร็จแล้ว
                                                </div>
                                            <% } %>
                                        </td>
                                        <td><%= dayjs(e.cds_date).format("DD/MM/YYYY") %> (<%= e.cds_phase %>)</td>
                                        <td><%= e.cdm_document_no %></td>
                                        <td><%= e.user_nane_en + " " + e.user_surname_en %> (<%= e.user_division %>)</td>
                                        <td><%= e.cdm_driver_type %> (<%= e.cdm_driver_name %>)</td>
                                        <td><%= e.cdm_eazy_pass %></td>
                                        <td><%= e.cdm_fuel_card %></td>
                                        <td><%= e.car_registration_code %></td>
                                        <td><%= e.car_name %> (<%= e.car_type %>)</td>
                                        <td><%= e.cdm_create_by_name %> (<%= e.cdm_create_by_division %>)</td>
                                        <td><%= dayjs(e.cdm_create_date).format("DD/MM/YYYY") %></td>
                                    </tr>
                                <% index++ } ) %>
                            </tbody>
                        </table>
                    </div>
                    <!-- <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12" id="include_work_div_table" style="margin-bottom: 7px;">

                    </div> -->
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_view_include_work" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">รายละเอียดงานรวบ</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 72vh; overflow: auto;">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12" id="view_include_work_div_table" style="margin-bottom: 5px;">

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark" style="margin-right: 0.3vw;"></i>
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_include_work" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">จัดการงานรวบ</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 72vh; overflow: auto;">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12" id="" style="margin-bottom: 10px;">
                        <span class="red">
                            * รถยนต์ และ คนขับ จะใช้ของงานหลัก โปรดเลือกงานหลักที่ต้องการ
                        </span>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12" id="include_work_div_table" style="margin-bottom: 5px;">

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button onclick="include_work_submit()" type="button" class="btn btn-success">
                    <i class="fa-solid fa-check" style="margin-right: 0.3vw;"></i>
                    บันทึก
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark" style="margin-right: 0.3vw;"></i>
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<%- include("2_footer.ejs") %>

<script>
    function include_work_submit(){
        let checkedRadio = document.querySelector('input[name="check_box_input"]:checked');

        if (checkedRadio) {
            Swal.fire({
            title: "ยืนยันการบันทึก",
            html: "ยืนยันการรวบงานหรือไม่ ? โปรดยืนยันการทำรายการ <br> <span class='red'> * รวบงานแล้ว จะไม่สามารถย้อนกลับได้</span>",
            icon : "question",
            showCancelButton: true,
            confirmButtonColor: "#027E6F",
            cancelButtonColor: "#00000040",
            confirmButtonText: "ยืนยัน, บันทึก" ,
            cancelButtonText: "ปิด"
        }).then((result) => {
            if (result.isConfirmed) {

                console.log( "checkedRadio" )
                console.log( checkedRadio.id )

                let data = {
                    include_work_id_all : checked_id_check_box_list_1.join(",") , 
                    include_work_id_main_work : checkedRadio.id
                }

                $.ajax({
                    type: 'POST',
                    url: '/include_work_submit',
                    data: data,
                    success: function (response) {
                        if( response.message == "Success" ){
                            Swal.fire({
                                title: "SUCCESS SUBMIT!",
                                text: "Your document was successfully saved.",
                                icon: "success"
                            });
                            
                            setTimeout( function(){window.location.reload} , 1000 );
                        }else{
                            Swal.fire({
                                title: "บันทึกไม่สำเร็จ",
                                text: "ระหว่างทำรายการ มีการเปลี่ยนข้อมูลรถ โปรดรีเฟรซแล้วทำรายการใหม่",
                                icon: "success"
                            });
                        }
                        
                        setTimeout( function(){window.location.reload()} , 1500 );
                    },
                    error: function (error) {
                        console.log("error with Ajax");
                        console.log(error);
                    }
                });
            }
        });
        }else{
            Swal.fire({
                title: "ไม่สามารถบันทึกได้",
                text: "ไม่สามารถบันทึกได้ กรุณาเลือกงานหลัก",
                icon: "error"
            });
        }
    }

    let checked_id_check_box_list_1 = []

    function update_check_box_list_1(){
        let all_check_box_list_1 = document.getElementsByName("check_box_list_1")

        let checked_check_box_list_1 = Array.from(all_check_box_list_1).filter(function(e) {
            return e.checked === true;
        });

        checked_id_check_box_list_1 = Array.from(checked_check_box_list_1).map(item => item.id)

        check_length_and_change_status_btn()
    }

    function check_length_and_change_status_btn(){
        if( checked_id_check_box_list_1.length <= 1 ){
            document.getElementById("length_include_work").innerText = `(${checked_id_check_box_list_1.length})`
            document.getElementById("btn_include_work").disabled = true

        }else{
            document.getElementById("length_include_work").innerText = `(${checked_id_check_box_list_1.length})`
            document.getElementById("btn_include_work").disabled = false
        }
    }

    async function include_work(){
        if( checked_id_check_box_list_1.length <= 1 ){
            alert("checked_id_check_box_list_1.length == 0")
        }else{
            data_no_syntex = '<%= JSON.stringify(document_alltime_data) %>'
            data_no_free_spec = (JSON.stringify(data_no_syntex.replace(/\n|\t|\r/g, " ")))
            data_with_syntax = decodedString( data_no_free_spec )
            data_to_obj = JSON.parse(data_with_syntax);

            let result = await get_data_include_work(data_to_obj)

            if( result.length > 0 ){
                include_work_create_table(result)
            }else{
                alert("กรุณาเลือกใหม่")
            }
        }
    }

    function get_data_include_work(data_to_obj){
        return new Promise( (resolve , reject) => {
            let data = []
            if( checked_id_check_box_list_1.length == 0 || data_to_obj.length == 0 ){
                resolve(data);
            }else{
                for( let i = 0 ; i < checked_id_check_box_list_1.length ; i++ ){
                    console.log("checked_id_check_box_list_1[i]")
                    console.log(checked_id_check_box_list_1[i])

                    let result = data_to_obj.filter( function(e){
                        return  e.cds_id == checked_id_check_box_list_1[i]
                    } )

                    if( result.length > 0 ){
                        data.push(...result)
                    }

                    if( i == checked_id_check_box_list_1.length - 1 ){
                        resolve(data)
                    }
                }
            }
        } )
    }

    function include_work_create_table( data ){
        if( data.length == 0 ){
            
        }else{
            let text = ""

            for(let i = 0 ; i < data.length ; i++){
                let index = i + 1
                let date = set_date_templece(data[i].cds_date , "/" , "en_short")
                let date_craete = set_date_templece(data[i].cdm_create_date , "/" , "en_short")
                text += `
                <tr>
                    <td>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="check_box_input" id="${data[i].cds_id}">
                        </div>
                    </td>
                    <td>${date} (${ data[i].cds_phase })</td>
                    <td>${data[i].cdm_destination_location}</td>
                    <td>${data[i].cdm_for_what}</td>
                    <td>${data[i].cdm_remark}</td>
                    <td>${data[i].cdm_document_no}</td>
                    <td>${data[i].user_nane_en + " " + data[i].user_surname_en } (${data[i].user_division})</td>
                    <td>${data[i].cdm_driver_type} (${data[i].cdm_driver_name})</td>
                    <td>${data[i].car_registration_code}</td>
                    <td>${data[i].car_name} (${data[i].car_type})</td>
                    <td>${data[i].cdm_create_by_name} (${data[i].cdm_create_by_division})</td>
                    <td>${date_craete}</td>
                </tr>`

                if( i == data.length - 1 ){
                    document.getElementById("include_work_div_table").innerHTML = `
                    <table id="include_work_table" class="table table-hover table-bordered" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>งานหลัก</th>
                                <th>วันที่ยืม</th>
                                <th>ปลายทาง</th>
                                <th>เดินทางไปเพื่อ</th>
                                <th>หมายเหตุ</th>
                                <th>Doc. NO.</th>
                                <th>ผู้ยืมชื่อ-นามสกุล (แผนก)</th>
                                <th>ผู้ขับ</th>
                                <th>ทะเบียนรถที่ยืม</th>
                                <th>ชื่อรถที่ยืม</th>
                                <th>ผู้สร้างชื่อ-นามสกุล (แผนก)</th>
                                <th>สร้างเมื่อ</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${text}
                        </tbody>
                    </table>`
                    $('#modal_include_work').modal('show');
                    setTimeout_set_table( "include_work_table" , 500)
                }
            }
        }
    }

    function admin_car_checking( main_document_id , sub_document_id ){
        Swal.fire({
            icon : "question",
            title: "ยืนยันการตรวจรถ",
            html: `ยืนยันการตรวจรถสำเร็จแล้วหรือไม่ ?
            <br>
            <br>
            <a href="/refueling_document/${btoa(sub_document_id)}" target="_blank" style="cursor: pointer;">
                <button type="button" class="btn btn-primary" style="color: white; margin-left: 10px;">
                    <i class="fa-solid fa-list"></i>
                    ดูประวัติการเติมน้ำมัน
                </button>
            </a>`,
            showCancelButton: true,
            confirmButtonColor: "#027E6F",
            cancelButtonColor: "#00000040",
            confirmButtonText: "ยืนยัน, ตรวจรถสำเร็จ" ,
            cancelButtonText: "ปิด"
        }).then((result) => {
            if (result.isConfirmed) {
                let data = {
                    main_document_id : main_document_id , 
                    sub_document_id : sub_document_id
                }

                console.log("data")
                console.log(data)
        
                $.ajax({
                    type: 'POST',
                    url: '/admin_car_checking',
                    data: data,
                    success: function (call_back_data) {
                        window.location.reload();
                    },
                    error: function (error) {
                        console.log("error with Ajax");
                        console.log(error);
                    }
                });
            }
        });
    }

    function send_car(){
        console.log(document_id_selected)

        Swal.fire({
            title: "ยืนยันการส่งรถ",
            text: "ยืนยันการส่งรถยนต์ให้กับผู้ขอใช้รถยนต์ ?",
            icon : "question",
            showCancelButton: true,
            confirmButtonColor: "#027E6F",
            cancelButtonColor: "#00000040",
            confirmButtonText: "ยืนยัน, ส่งรถ" ,
            cancelButtonText: "ปิด"
        }).then((result) => {
            if (result.isConfirmed) {

                let data = {
                    document_id : document_id_selected , 
                    car_id : car_id_selected ,
                    last_miles : document.getElementById("last_mile").value
                }

                console.log("data")
                console.log(data)
        
                $.ajax({
                    type: 'POST',
                    url: '/admin_send_car',
                    data: data,
                    success: function (call_back_data) {
                        window.location.reload();
                    },
                    error: function (error) {
                        console.log("error with Ajax");
                        console.log(error);
                    }
                });
            }
        });
    }

    let document_id_selected = ""
    let car_id_selected = ""

    function set_last_miles( document_id , registration_code , car_id , last_miles ){
        console.log(document_id)
        console.log(last_miles)

        document_id_selected = document_id
        car_id_selected = car_id

        document.getElementById("last_mile").value = last_miles
        document.getElementById("car_registration_code").innerText = registration_code
    }

    $('#main_table').DataTable({
        // "destroy": true,
        // "retrieve":true,
        // "stateSave": true,
        fixedColumns:   {
            left: 0 ,
            right: 0
        },
        "paging": true,
        "scrollCollapse": true,
        "responsive": true, 
        "lengthChange": true, 
        "searching": true,
        "autoWidth": true,
        "ordering": true,
        "info": true,
        "scrollX": true,
        "scrollY": "48vh" 
    })

</script>