    function ViewDocument( element ){
        console.log(element.dataset.document)
        const data = JSON.parse(element.dataset.document);
        console.log(data)

        let tableText = ""
        if( data.length === 0 ){
            SetDocumentModal(tableText)
        }else{
            for( let i = 0 ; i < data.length ; i++ ){
                let index = i + 1
                tableText += `
                <tr>
                    <td>
                        <a href="/ticket_requset_document_view/${btoa(data[i].tds_join_jdm_id)}" target="_blank">
                            ${index} 
                        </a>
                    </td>
                    <td>${set_date_templece(data[i].tds_want_date , "" , "th_long" , false)}</td>

                    <td>${data[i].tds_create_by_name}</td>
                    <td>${data[i].tds_create_by_email}</td>
                    <td>${data[i].tds_create_by_division}</td>

                    <td>${data[i].tds_want_brand}</td>
                    
                    <td>${data[i].tds_ticket_code_generated}</td>
                    <td>${data[i].tdfg_service_type}</td>
                    <td>${data[i].tds_want_remark}</td>
                    <td>${data[i].tdfg_order_description}</td>
                    <td style="text-align: end;" >${((+data[i].tdfg_total)||"").toLocaleString("th-TH") || ""} บาท</td>
                </tr>`

                if( i === data.length - 1 ){
                    SetDocumentModal(tableText)
                }
            }
        }
    }

